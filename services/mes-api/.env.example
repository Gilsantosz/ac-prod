# Credenciais somente no servidor. Nunca utilizar VITE_ ou enviar ao navegador.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=
API_TOKEN=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
DB_POOL_MAX=30
DB_QUEUE_MAX=2000
DB_ACQUIRE_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Este valor documenta o statement_timeout aplicado ao papel mes_api no banco.
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=7000
DB_SSL=verify-full
# Certificado CA público oficial do Supabase, incluído na imagem:
DB_SSL_ROOT_CERT=supabase-ca.crt
SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=warn
