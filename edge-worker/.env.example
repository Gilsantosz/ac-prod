# Supabase do AC.Prod2
SUPABASE_URL=https://uozuzdfvnufsjsonswag.supabase.co
SUPABASE_PUBLISHABLE_KEY=cole-a-chave-publicavel-do-projeto

# Conta Auth dedicada ao equipamento. Não use service_role no chão de fábrica.
SUPABASE_EDGE_EMAIL=coletor01@empresa.local
SUPABASE_EDGE_PASSWORD=troque-esta-senha

# Token da sessão operacional gerado pelo login do operador no AC.Prod2.
OPERATOR_SESSION_TOKEN=cole-o-token-da-sessao-operacional

# Contexto fixo do posto
CELL_NAME=Corte
SHIFT=1º Turno
OPERATOR_NAME=Operador Coletor 01
OPERATOR_ID=
MACHINE_ID=
MACHINE_NAME=Corte CNC 01
DEVICE_ID=edge-corte-01
READER_TYPE=keyboard_barcode

# API local. Loopback é o padrão seguro.
EDGE_HOST=127.0.0.1
PORT=8787
# Obrigatório quando EDGE_HOST for exposto na rede local (ex.: 0.0.0.0).
EDGE_INGEST_TOKEN=

# Worker
FLUSH_INTERVAL_MS=5000
MAX_BATCH_SIZE=50
EDGE_SPOOL_FILE=./data/collection-spool.jsonl
SIMULATE_COUNT=20
SIMULATE_INTERVAL_MS=80
