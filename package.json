{
  "name": "leo-flow",
  "private": true,
  "version": "1.4.1-kpi-sync",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "update:local": "bash ./ATUALIZAR_ACPROD.command",
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "node scripts/build-electron.js && electron .",
    "dev:desktop": "concurrently -k \"npm run dev:web\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development npm run dev:electron\"",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:desktop": "cross-env VITE_APP_BASE=./ npm run build:web && npm run build:electron",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:linux": "npm run build:desktop && electron-builder --linux",
    "dist:all": "npm run build:desktop && electron-builder -wml",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "secretlint --maskSecrets \"**/*\"",
    "security:check": "npm run security:audit && npm run security:secrets"
  },
  "dependencies": {
